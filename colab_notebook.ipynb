        "    '/content/movie_review_sentiment',\n",
        "]\n",
        "base_dir = None\n",
        "for d in candidates:\n",
        "    if os.path.exists(os.path.join(d, 'app_gradio.py')):\n",
        "        base_dir = d\n",
        "        break\n",
        "if base_dir is None:\n",
        "    raise FileNotFoundError('app_gradio.py not found. Upload the whole folder and open this notebook from inside it.')\n",
        "\n",
        "sys.path.insert(0, base_dir)\n",
